 "poems": [
  {
   "seq": "1",
   "text": "なには江に咲やこの花しろ妙の秋なき浪をてらす月影",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "みふねこくほり江の水も底すみて玉しく月の影そさえける",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "秋はなをことしの空も津の國のなにはかはらすみしま江の月",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "すみのえの波に秋風吹よせてたまゆらなびく月の影かな",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "住の江のきしの松かせ吹まゝになみさへはなの秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "秋風の蘆のうら葉を吹わけて玉江の水にやとる月かけ",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "思ひつゝ獨たひねの夢にたにみゆとは見えぬ人の面かけ",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "いたつらにひとりなかめし夜半の雲さてもかさなる旅の空哉",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "玉江こくあしかり小舟あとみえて水の秋とや月もすむ覽",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "風そよく蘆の葉わたる夜半の月たれみしま江にわたるなる蘭",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "蘆のやのなたの入江の月をみてぬるゝかあまの袖のうらなみ",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "から衣たひねなれきて久かたの秋の露しも袖にくちぬる",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "をのつからたのむ夢路に跡たえてぬれとねられぬさよの中山",
   "kana": "",
   "speaker": "",
   "page": 210,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "とゝめおきし袖のなかにや玉くしけふたみの浦は夢も結はす",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "逢事はたゆひの浦の旅まくらこがれそあかす夜半のもしほ火",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "都にはかこちかねにし我袖にあまるもしらす野への夕つゆ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "面かけのしたはぬたひの夢覺てあはれ都の露は物かは",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "俤をいくへの雲にさそひきてがたしく山の床のあき風",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "戀しともえやはいはれの草枕むすひかをきし跡の契を",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "秋の色はとやまの松の夕しくれつれなき名のみ猶やふりなん",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夕されにさひしかれとも高砂の松をおのへに秋かせそふく",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "松の葉はもみらぬ秋のゆふたすきたむけの山を月にまかせて",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "たれこゝに岩のかけちを跡たえてあらしやくれの松かせの聲",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "秋はいぬ夕日かくれの峯の松よるの木のはの後もあひみん",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "高砂のおのへの松の夕しくれかくてふり行身をやつくさん",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "今よりの夕ゐる雲やさそふらんしくれをならす峯の松かせ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "山ふかき秋にやかこつ夕暮を松にとてのみふかぬあらしも",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "夕つくひうつろふ山の松の葉はいつともわかす色そつれなき",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "から錦たつたの山の夕霧になをいろふかき峯のまつかせ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
